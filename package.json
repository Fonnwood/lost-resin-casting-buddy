{
  "name": "lost-resin-casting-buddy",
  "version": "1.0.0",
  "description": "Mobile-first process companion and timing dashboard for vacuum-assisted investment casting of resin-printed models.",
  "private": true,
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fonnwood/lost-resin-casting-buddy.git"
  },
  "scripts": {
    "start": "node scripts/serve.js",
    "start:lan": "node scripts/serve.js --host 0.0.0.0",
    "dev": "node scripts/serve.js --dev",
    "db:setup": "node scripts/db-setup.js",
    "test": "node --test \"tests/**/*.test.js\"",
    "test:e2e": "node tests/e2e.js",
    "lint": "eslint .",
    "check": "npm run lint && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "playwright": "1.56.1"
  },
  "dependencies": {
    "@vercel/functions": "^3.9.11",
    "pg": "^8.23.1",
    "web-push": "^3.6.7"
  }
}
