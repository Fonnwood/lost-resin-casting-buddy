  "description": "Mobile-first process companion and timing dashboard for vacuum-assisted investment casting of resin-printed models.",
  "private": true,
  "license": "MIT",
  "type": "commonjs",
  "engines": { "node": ">=20" },
  "repository": { "type": "git", "url": "git+https://github.com/fonnwood/lost-resin-casting-buddy.git" },
